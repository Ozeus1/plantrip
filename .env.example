# Porta exclusiva no host da VPS. Mantenha igual no proxy reverso.
PLANTRIP_PORT=18080
# Produção com HTTPS: 1. Para testar login por HTTP local: 0.
COOKIE_SECURE=1
# Produção: cadastro inicial pela interface desabilitado.
# Crie o administrador com docker compose exec plantrip python scripts/create_admin.py
ALLOW_SETUP=0
